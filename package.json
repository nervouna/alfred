{
  "name": "alfred",
  "version": "0.1.0",
  "private": true,
  "description": "Personal research assistant on WeChat (iLink) powered by the Claude Agent SDK",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "login": "node src/cli.ts login",
    "start": "node src/cli.ts run",
    "push": "node src/cli.ts push",
    "status": "node src/cli.ts status",
    "check": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/qrcode-terminal": "0.12.2",
    "typescript": "7.0.2"
  }
}
