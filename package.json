{
  "name": "alfred",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Personal research assistant on WeChat (iLink) powered by the Claude Agent SDK",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "login": "node src/cli.ts login",
    "start": "node src/cli.ts run",
    "push": "node src/cli.ts push",
    "status": "node src/cli.ts status",
    "setup:pdf": "node src/cli.ts setup-pdf",
    "memory-scan": "node src/cli.ts memory-scan",
    "check": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "smoke": "node scripts/agent-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.295",
    "marked": "18.0.14",
    "playwright-core": "1.63.0",
    "qrcode-terminal": "0.12.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/qrcode-terminal": "0.12.2",
    "typescript": "7.0.2"
  }
}
